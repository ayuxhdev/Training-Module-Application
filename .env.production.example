# TEMPLATE ONLY. Never put real secrets in this tracked file.
# Export through the service's protected environment; do not deploy a developer .env.
DJANGO_SETTINGS_MODULE=config.production
DJANGO_ENVIRONMENT=staging
DEBUG=false
DJANGO_SECRET_KEY=
ALLOWED_HOSTS=training.example.invalid
CSRF_TRUSTED_ORIGINS=
TRUST_X_FORWARDED_PROTO=false
SECURE_HSTS_SECONDS=3600
SECURE_HSTS_INCLUDE_SUBDOMAINS=false
SECURE_HSTS_PRELOAD=false
DB_NAME=gardens_training
DB_USER=gardens_app
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306
# Remote MySQL requires an absolute, readable CA file and certificate identity verification.
DB_SSL_CA=
DB_CONNECT_TIMEOUT=5
DB_READ_TIMEOUT=30
DB_WRITE_TIMEOUT=30
DB_CONN_MAX_AGE=60
# Examples only; operator provisions private storage and release-specific static output.
STATIC_ROOT=/srv/gardens/static/releases/RELEASE_ID
PRIVATE_MEDIA_ROOT=/srv/gardens-private/media
VIDEO_FFPROBE_PATH=ffprobe
# Empty means not activated. Select and persist one aware UTC timestamp before scheduling.
NOTIFICATIONS_ACTIVATED_AT=
