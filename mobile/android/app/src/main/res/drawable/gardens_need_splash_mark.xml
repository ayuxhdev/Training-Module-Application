<?xml version="1.0" encoding="utf-8"?>
<!-- Android supplies square bounds. Keep the 2084:945 artwork inside its
     two-thirds safe circle, even when rasterized into a smaller square. -->
<inset xmlns:android="http://schemas.android.com/apk/res/android"
    android:insetLeft="21%"
    android:insetRight="21%"
    android:insetTop="36.85%"
    android:insetBottom="36.85%">
    <bitmap
        android:src="@drawable/gardens_need_logo"
        android:gravity="fill"
        android:filter="true" />
</inset>
